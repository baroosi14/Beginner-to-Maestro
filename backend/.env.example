APP_ENV=production
APP_URL=https://api.beginnertomaestro.com
JWT_SECRET=your-very-long-random-secret-here
ALLOWED_ORIGINS=https://beginnertomaestro.com,https://app.beginnertomaestro.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=beginner_to_maestro
DB_USERNAME=btm_user
DB_PASSWORD=strong_db_password

STORAGE_DRIVER=local

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Paystack
PAYSTACK_SECRET_KEY=sk_live_xxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxx

# Flutterwave
FLUTTERWAVE_SECRET_KEY=FLWSECK_xxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_xxxx

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# PayPal
PAYPAL_CLIENT_ID=xxxx
PAYPAL_CLIENT_SECRET=xxxx
PAYPAL_MODE=live

# Zoom
ZOOM_API_KEY=xxxx
ZOOM_API_SECRET=xxxx

# Email
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=SG.xxxx
MAIL_FROM=noreply@beginnertomaestro.com
MAIL_FROM_NAME="Beginner to Maestro"
